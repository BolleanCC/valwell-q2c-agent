{
  "name": "valwell-q2c-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Quote-to-invoice reconciliation agent demo with mock source systems and an evaluation harness",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "lefthook install",
    "generate": "tsx packages/generator/src/cli.ts",
    "agent": "tsx packages/agent/src/cli.ts",
    "eval": "tsx packages/eval/src/cli.ts",
    "demo": "tsx packages/eval/src/demo-cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
